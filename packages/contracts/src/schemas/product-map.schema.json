{
  "$id": "https://behavior-map.dev/schemas/product-map.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "product-map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journey_ids",
    "surfaces",
    "controls",
    "journeys",
    "effects",
    "display"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "journey_ids": { "type": "array", "items": { "type": "string" } },
    "surfaces": { "type": "array" },
    "controls": { "type": "array" },
    "journeys": { "type": "array" },
    "effects": { "type": "array" },
    "display": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array" }
      }
    }
  }
}
