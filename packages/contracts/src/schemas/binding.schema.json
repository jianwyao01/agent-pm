{
  "$id": "https://behavior-map.dev/schemas/binding.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "control_id",
    "approved_locator",
    "approved_by",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "binding_id": { "type": "string", "minLength": 1 },
    "control_id": { "type": "string", "minLength": 1 },
    "approved_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["accessibility", "role", "title", "label"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "approved_by": { "const": "human" },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
