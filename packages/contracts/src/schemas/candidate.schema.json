{
  "$id": "https://behavior-map.dev/schemas/candidate.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "scope_id",
    "discovered_by",
    "evidence_refs",
    "execution_status",
    "scope_status",
    "review_status",
    "rejection_reason",
    "discovery_key",
    "label"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["entry", "surface", "control", "interaction", "effect"] },
    "scope_id": { "type": "string", "minLength": 1 },
    "discovered_by": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "execution_status": {
      "enum": ["observed", "executed", "not_executed", "unreachable", "unsupported", "uncertain"]
    },
    "scope_status": { "enum": ["in_scope", "out_of_scope", "unresolved"] },
    "review_status": { "enum": ["unreviewed", "kept", "rejected", "merged"] },
    "rejection_reason": { "type": ["string", "null"] },
    "discovery_key": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 }
  }
}
