{
  "$id": "https://behavior-map.dev/schemas/run-plan.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secret_refs", "components", "confirmation"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret_ref"],
        "properties": {
          "secret_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": { "type": "array", "items": { "type": "string" } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "confirmed"] },
        "confirmed_at": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "depends_on", "install", "start_order", "healthcheck", "logs", "seed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "healthcheck" }
        },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "start_order": { "type": "integer" },
        "healthcheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["http", "tcp", "command"] },
            "url": { "type": "string", "minLength": 1 },
            "port": { "type": "integer" },
            "command": { "type": "string", "minLength": 1 }
          }
        },
        "logs": { "type": "string", "minLength": 1 },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_done", "present"] },
            "path": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
