{
  "$id": "https://behavior-map.dev/schemas/run-plan.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "study_id", "scope_id", "secret_refs", "steps"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret_ref"],
        "properties": {
          "secret_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": { "type": "array", "items": { "type": "string" } }
  }
}
